--- a/apps/mac/scripts/make-app.sh
+++ b/apps/mac/scripts/make-app.sh
@@ -257,6 +257,38 @@
   cp -R "$MAC_DIR/Samples/." "$SAMPLES_DIR/"
 fi
 
+# --- Pinned bundle metrics (before signing; no download or host-TeX fallback) ---
+: "${FLASHTEX_BUNDLE_TEXMF_ROOT:?set to the verified official LM2.004 texmf resource root}"
+BUNDLE_RESOURCE_VERIFIER="$REPO_ROOT/crates/rendering-core/tools/verify_bundle_resources.py"
+[[ -f "$BUNDLE_RESOURCE_VERIFIER" ]] || die "missing pinned bundle resource verifier"
+python3 - "$BUNDLE_RESOURCE_VERIFIER" "$FLASHTEX_BUNDLE_TEXMF_ROOT" "$RESOURCES_DIR" <<'PY_ASSETS'
+import os
+from pathlib import Path
+import runpy
+import shutil
+import sys
+
+verifier_path, source_root, resources = sys.argv[1:]
+v = runpy.run_path(verifier_path)
+manifest = v["pinned_manifest"]()
+source_fd = os.open(source_root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+try:
+    for entry in manifest["required_for_existing_fixtures"]:
+        if not entry["path"].startswith("texmf/"):
+            continue  # Existing OTF copy is verified with the complete stage below.
+        source_entry = dict(entry, path=entry["path"][len("texmf/"):])
+        result = v["check_resource"](source_fd, source_entry)
+        if result["status"] != "verified":
+            raise SystemExit("official bundle metric refused: " + str(result))
+        destination = Path(resources) / entry["path"]
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(Path(source_root) / source_entry["path"], destination)
+finally:
+    os.close(source_fd)
+PY_ASSETS
+python3 "$BUNDLE_RESOURCE_VERIFIER" "$RESOURCES_DIR" > "$RESOURCES_DIR/resource-coverage.json"   || die "pinned bundle resources failed verification; refusing signing"
+# --- End pinned bundle metrics ---
+
 # --- Helpers -----------------------------------------------------------------
 echo "==> Locating built Rust binaries (helper root: $HELPER_ROOT)"
 BUNDLED_HELPERS=()   # "key|name|source" for every helper actually copied
