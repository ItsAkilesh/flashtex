{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashtex.invalid/schema/visual-manifest-v1.json",
  "title": "FlashTeX visual source and reference manifest",
  "description": "Schema validity/source integrity never establishes pixel fidelity. Missing generated artifacts remain pending. Runtime checker verifies hashes, geometry and fixture binding.",
  "type": "object",
  "required": [
    "schema_version",
    "profiles",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "page": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pixel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256 of row-major RGBA8 bytes; RGB receives opaque alpha only."
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "number",
        "path",
        "sha256",
        "pixel_sha256",
        "width",
        "height"
      ]
    },
    "reference": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "format_date": {
          "type": "string",
          "minLength": 1
        },
        "generation_host": {
          "type": "string",
          "minLength": 1
        },
        "generation_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "package_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "font_program",
                        "metrics"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "path",
                    "sha256"
                  ]
                },
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "kind": {
                          "const": "font_program"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "kind": {
                          "const": "metrics"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "name",
              "files"
            ]
          }
        },
        "render": {
          "type": "object",
          "properties": {
            "dpi": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "media_box_bp": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "page_pixels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "color_space": {
              "const": "RGB"
            },
            "background": {
              "const": "white"
            },
            "color_profile": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "unmanaged"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "mode",
                    "description"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "icc"
                    },
                    "file": {
                      "$ref": "#/$defs/file"
                    }
                  },
                  "required": [
                    "mode",
                    "file"
                  ]
                }
              ]
            },
            "argv_template": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "dpi",
            "media_box_bp",
            "page_pixels",
            "color_space",
            "background",
            "color_profile",
            "argv_template"
          ]
        },
        "rasterizer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "binary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "name",
            "version",
            "binary_sha256"
          ]
        },
        "pdf": {
          "$ref": "#/$defs/file"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      },
      "required": [
        "source_sha256",
        "engine",
        "engine_version",
        "format_date",
        "generation_host",
        "generation_time_utc",
        "package_versions",
        "fonts",
        "render",
        "rasterizer",
        "pdf",
        "pages"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "reference_engine": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "font_policy": {
          "type": "string",
          "minLength": 1
        },
        "required_packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "page_media_box_bp": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "dpi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expected_page_pixels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "rasterizer": {
          "type": "string",
          "minLength": 1
        },
        "rasterizer_version": {
          "type": "string",
          "minLength": 1
        },
        "raster_argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "comparison": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "minLength": 1
            },
            "required_max_channel_delta": {
              "const": 0
            },
            "required_differing_pixel_count": {
              "const": 0
            },
            "color_channels": {
              "type": "string",
              "minLength": 1
            },
            "forbidden_adjustments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "allOf": [
                {
                  "contains": {
                    "const": "auto-alignment"
                  }
                },
                {
                  "contains": {
                    "const": "rescaling"
                  }
                },
                {
                  "contains": {
                    "const": "cropping"
                  }
                },
                {
                  "contains": {
                    "const": "blur"
                  }
                },
                {
                  "contains": {
                    "const": "font substitution"
                  }
                },
                {
                  "contains": {
                    "const": "threshold relaxation"
                  }
                }
              ]
            },
            "secondary_diagnostics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "secondary_metrics_are_not_a_pass": {
              "const": true
            }
          },
          "required": [
            "primary",
            "required_max_channel_delta",
            "required_differing_pixel_count",
            "color_channels",
            "forbidden_adjustments",
            "secondary_diagnostics",
            "secondary_metrics_are_not_a_pass"
          ]
        }
      },
      "required": [
        "reference_engine",
        "engine_version",
        "font_policy",
        "required_packages",
        "page_media_box_bp",
        "dpi",
        "expected_page_pixels",
        "rasterizer",
        "rasterizer_version",
        "raster_argv",
        "comparison"
      ]
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entry_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "expected_page_count": {
          "type": "integer",
          "minimum": 1
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparison_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reference_state": {
          "enum": [
            "not_generated",
            "pending",
            "generated"
          ]
        },
        "candidate_state": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "id",
        "entry_path",
        "source_sha256",
        "profile",
        "expected_page_count",
        "features",
        "comparison_gates",
        "reference_state",
        "candidate_state"
      ]
    }
  }
}
