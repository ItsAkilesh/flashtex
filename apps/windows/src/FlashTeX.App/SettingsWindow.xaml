<!-- Singleton auxiliary window: editor font/theme/auto-compile preferences.
     Applies every change live (no OK/Cancel/Apply), matching the Mac port's
     SettingsRootView design (apps/mac/Sources/FlashTeXMac/EditorPreferences.swift). -->
<Window
    x:Class="FlashTeX.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="SettingsRootGrid" Padding="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Left">

                <StackPanel Spacing="8">
                    <TextBlock Text="Editor" FontWeight="SemiBold" FontSize="16" />

                    <TextBlock Text="Font family" Opacity="0.8" />
                    <ComboBox x:Name="FontFamilyCombo" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Editor font family" />

                    <TextBlock Text="Font size" Opacity="0.8" Margin="0,8,0,0" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontSizeSlider" Grid.Column="0"
                                Minimum="8" Maximum="36" StepFrequency="1" SmallChange="1" LargeChange="2"
                                AutomationProperties.Name="Editor font size" />
                        <TextBlock x:Name="FontSizeReadout" Grid.Column="1" VerticalAlignment="Center"
                                   MinWidth="48" TextAlignment="Right" />
                    </Grid>

                    <TextBlock x:Name="FontSampleText" Text="\section{Sample} $x^2 + y^2 = z^2$"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Font sample" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Color theme" Opacity="0.8" />
                    <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Color theme">
                        <ComboBoxItem Content="System" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Compile" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Auto-compile after edits" Opacity="0.8" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DebounceSlider" Grid.Column="0"
                                Minimum="50" Maximum="2000" StepFrequency="50" SmallChange="50" LargeChange="200"
                                AutomationProperties.Name="Auto-compile debounce interval" />
                        <TextBlock x:Name="DebounceReadout" Grid.Column="1" VerticalAlignment="Center"
                                   MinWidth="64" TextAlignment="Right" />
                    </Grid>
                    <TextBlock Text="How long to wait after you stop typing before compiling automatically."
                               Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>

                <Button x:Name="RestoreDefaultsButton" Content="Restore Defaults" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
